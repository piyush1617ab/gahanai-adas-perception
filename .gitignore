# ============================================================
runs/
wandb/
checkpoints/
outputs/
predictions/
logs/
*.log
dataset_inventory.json

# ============================================================
# Local full-size datasets
# Only the curated samples under datasets/ (README files, the
# single sample frame + labels, sanitized CVAT/JSON schema
# samples) are tracked. If you point training scripts at a full
# local copy of OpenADAS / BDD100K, keep it outside this repo or
# under one of the paths below.
# ============================================================
datasets/open_adas/scene_*/
datasets/open_adas/train/
datasets/open_adas/val/
datasets/bdd100k/images/
datasets/bdd100k/labels/
datasets/lane_detection/train/
datasets/lane_detection/val/
datasets/lane_detection/test/
datasets/**/merged_dataset/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================
# IDEs / OS files
# ============================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Environment / secrets — never commit these
# ============================================================
.env
.env.*
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# ============================================================
# Archives
# ============================================================
*.zip
*.tar
*.tar.gz

